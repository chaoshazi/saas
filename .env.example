# --- Core ---
APP_NAME=AICRM SaaS
APP_ENV=development
DEBUG=true
# Seed rich Chinese demo data on startup (users/teams/projects/tasks...)
SEED_DEMO=false
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database (MySQL 8 for production; SQLite for local tests) ---
DATABASE_URL=mysql+asyncmy://saas:saas@127.0.0.1:3306/saas?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOTP_ISSUER=AICRM SaaS

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./uploads

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- WeCom ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# --- Payments ---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_SERIAL_NO=
WECHAT_PLATFORM_CERT=

# --- License ---
LICENSE_PUBLIC_KEY=
LICENSE_ISSUER=saas-licensing

# --- Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
